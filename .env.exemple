# Copiez ce fichier en .env et complétez les deux premières lignes avec les informations
# données en début de séance. Ne partagez jamais votre fichier .env.

MQTT_IDENTIFIANT=binome-XX
MQTT_MDP=

# Mot de passe du plan B (donné si besoin en séance)
PLAN_B_MDP=

# Broker ne pas modifier
MQTT_HOTE=master2026.lemansschoolofai.fr
MQTT_PORT=443
MQTT_TRANSPORT=websockets
MQTT_TLS=1
MQTT_CHEMIN_WS=/mqtt
